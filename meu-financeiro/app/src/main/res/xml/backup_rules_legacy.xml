<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: exclude everything from cloud backup. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
